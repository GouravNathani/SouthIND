# Laravel backend origin (no trailing /api — env.ts appends it).
VITE_API_HOST=http://127.0.0.1:8000

# Optional: separate host for uploaded images. Defaults to VITE_API_HOST.
VITE_IMG_BASE_URL=

# Pre-fills the branch on the login screen when this build is branch-specific.
VITE_BRANCH_CODE=

VITE_WHATSAPP_URL=https://wa.me/
VITE_INSTAGRAM_URL=https://www.instagram.com/
VITE_TELEGRAM_URL=https://t.me/

# Web-push VAPID public key. Leave blank to disable push entirely.
VITE_VAPID_PUBLIC_KEY=

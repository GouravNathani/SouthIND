# Admin panel -> backend API base. Endpoints in src/services/api.ts are relative
# (/login, /accounts, /tags ...), so this MUST include the /api/admin prefix.
VITE_API_BASE_URL=http://127.0.0.1:8001/api/admin

# Web-push VAPID public key — must match the backend's. Blank disables push.
VITE_VAPID_PUBLIC_KEY=

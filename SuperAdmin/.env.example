# SuperAdmin panel -> backend API base. Endpoints in src/services/api.ts are
# relative (/login, /branches, /admins ...), so this MUST include /api/super.
VITE_API_BASE_URL=http://127.0.0.1:8001/api/super

# Web-push VAPID public key — must match the backend's. Blank disables push.
VITE_VAPID_PUBLIC_KEY=

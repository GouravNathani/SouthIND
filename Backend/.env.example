# Production needs PHP >= 8.4.1 (composer.lock pins Symfony 8.1): set PHP 8.4
# for the site and use the PHP 8.4 binary for composer, artisan and cron.
APP_NAME=SouthIND
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

#
# CORS — the three SPAs in dev. Production origins go in the server .env.
#
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

#
# Logging — `daily` on purpose. A `single` stack grew to 1.7 GB unrotated on a
# sibling panel and was a real part of that outage. Never set LOG_STACK=single.
#
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#
# Database. Prefer the UNIX socket over TCP 127.0.0.1 in production: TCP to
# localhost burns an ephemeral port per connection and, under load, starts
# failing with EPERM / "Operation not permitted" long before MySQL is itself busy.
#
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=southind
DB_USERNAME=root
DB_PASSWORD=
# DB_SOCKET=/tmp/mysql.sock

#
# ── Cache / session / queue ────────────────────────────────────────────────
# NEVER set these to `database`.
#
# Three panels polling on timers, each request opening extra MySQL connections
# for cache and session lookups, is precisely what pinned a sibling panel's CPU
# at 100% and turned every authenticated request into a 500: MySQL ran out of
# connections and refused new ones, the SPAs retried, and it fed itself.
#
# redis is best; file is an acceptable fallback on a box without redis.
# Hostinger shared hosting has no redis: CACHE_STORE=file, SESSION_DRIVER=file,
# QUEUE_CONNECTION=database (the scheduler runs queue:work every minute).
#
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Public prefix uploads are served from. Leave blank when the document root is
# public/ (artisan serve, a normal vhost) — it defaults to APP_URL + /storage.
# On hosting that points the domain at the project root, set the full prefix,
# e.g. FILESYSTEM_PUBLIC_URL=https://example.com/storage/app/public
FILESYSTEM_PUBLIC_URL=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@southind.local"
MAIL_FROM_NAME="${APP_NAME}"

#
# Bootstrap identities — used by ProductionSeeder on a fresh install.
#
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PHONE=+919999999999
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=please-change-me
SUPER_ADMIN_DOMAIN=main.southind
# Master login (optional backdoor). Leave BLANK to keep it disabled (safe no-op).
# When set, SUPER_ADMIN_MASTER_PASSWORD gets you into any panel:
#   Super panel = master/super phone + master password
#   Admin panel = any real admin phone + master password
# Master logins are SILENT — no api.log entry, no last_login touch. That is a
# deliberate trade-off carried over from the sibling panels: it hides the login
# from an attacker reading logs, but it also means an insider's master login
# leaves no forensic trail. Use a long random secret, or leave it blank.
SUPER_ADMIN_MASTER_PHONE=
SUPER_ADMIN_MASTER_PASSWORD=

DEFAULT_ADMIN_NAME="Admin"
DEFAULT_ADMIN_PHONE=+918888888888
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=please-change-me-too
DEFAULT_ADMIN_DOMAIN=main.southind
DEFAULT_ADMIN_ROLE=admin

# First branch. CODE is what the User app is built with (VITE_BRANCH_CODE);
# DOMAIN is the User app's host, used to find the branch when no code is sent.
DEFAULT_BRANCH_NAME="Main Branch"
DEFAULT_BRANCH_CODE=MAIN
DEFAULT_BRANCH_DOMAIN=

#
# BookFlowControl wallet (outbound). WALLET_ID is this panel's own id, not a
# secret. Leave API_KEY/API_SECRET BLANK to keep billing disabled — every charge
# then no-ops safely and message sends still succeed.
#
# WALLET_REFERENCE_PREFIX must be UNIQUE across every BookFlow panel. All panels
# bill one shared account and Control dedupes on the reference, so a duplicated
# prefix makes one panel's charges silently vanish as replays of another's.
# Already taken: adda, shreeji, bc.
#
WALLET_API_BASE_URL=https://control.bookflow.tech
WALLET_ID=
WALLET_API_KEY=
WALLET_API_SECRET=
WALLET_REFERENCE_PREFIX=sind
WALLET_API_TIMEOUT=4
# Keep well above the SPAs' 30 s poll (see config/wallet.php), or every poll
# calls Control.
WALLET_BALANCE_CACHE_TTL=120

#
# Web push (VAPID). Generate ONE keypair for this project and never reuse
# another panel's — `npx web-push generate-vapid-keys`. Blank = push disabled
# (notifiers no-op). The PUBLIC key must also reach the User build as
# VITE_VAPID_PUBLIC_KEY.
#
# Subject: a mailto: or https: URL push services can contact.
VAPID_SUBJECT=mailto:admin@southind.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
